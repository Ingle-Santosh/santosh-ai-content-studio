APP_ENV=development
LOG_LEVEL=INFO
LOCAL_ONLY=true
DATA_DIR=./data
# Optional explicit override; defaults to sqlite+aiosqlite:///<DATA_DIR>/content_studio.db
DATABASE_URL=
API_BASE_URL=http://127.0.0.1:8000

# Local LLM (Ollama — default zero-cost provider for lightweight / all steps)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen3.5:9b
OLLAMA_WRITING_MODEL=
OLLAMA_FAST_MODEL=

# Optional Cloud LLM provider for important steps or full cloud mode (when LOCAL_ONLY=false)
# Supported: gemini, openai, anthropic, openai_compatible (OpenRouter, Groq, DeepSeek, etc.)
CLOUD_LLM_PROVIDER=gemini
CLOUD_API_KEY=
CLOUD_BASE_URL=
CLOUD_DEFAULT_MODEL=
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514

# Execution & Budget Guardrails
MAX_BUDGET_USD=0.0
LLM_TIMEOUT_SECONDS=180.0
LLM_MAX_RETRIES=2

# Web Research (duckduckgo requires no API key; tavily requires SEARCH_API_KEY)
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=
RESEARCH_FETCH_TIMEOUT_SECONDS=15.0
RESEARCH_MAX_RESULTS_PER_QUERY=5

# Optional Public YouTube Data API v3 key (falls back to zero-key public search + oEmbed)
YOUTUBE_API_KEY=
YOUTUBE_MAX_COMPETITORS=5
