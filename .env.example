APP_ENV=development
LOG_LEVEL=INFO
LOCAL_ONLY=true
DATA_DIR=./data
# Optional explicit override; defaults to sqlite+aiosqlite:///<DATA_DIR>/content_studio.db
DATABASE_URL=
API_BASE_URL=http://127.0.0.1:8000

# Local LLM (Ollama — default zero-cost provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:14b
OLLAMA_WRITING_MODEL=
OLLAMA_FAST_MODEL=

# Optional Cloud LLM fallback (used only when LOCAL_ONLY=false and budget allows)
CLOUD_LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# Execution & Budget Guardrails
MAX_BUDGET_USD=0.0
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=2

# Web Research (duckduckgo requires no API key; tavily requires SEARCH_API_KEY)
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=
RESEARCH_FETCH_TIMEOUT_SECONDS=15.0
RESEARCH_MAX_RESULTS_PER_QUERY=5
